# Login with OpenID Connect, like Meridian. With WorkOS: the issuer is your AuthKit domain,
# and the client is a first-party, confidential application under Connect. Register
# http://localhost:4000/auth/callback (and https://<PHX_HOST>/auth/callback) as its
# redirect URIs.
OIDC_ISSUER=https://your-name.authkit.app
OIDC_CLIENT_ID=client_...
OIDC_CLIENT_SECRET=

# Comma-separated. These guests are hosts when they log in; hosts can make others hosts.
HOST_EMAILS=you@example.com

# Production only (deploy/app sets DATABASE_PATH and UPLOADS_PATH itself).
# PHX_HOST=halloween.example.com
# SECRET_KEY_BASE=   generate with: mix phx.gen.secret
